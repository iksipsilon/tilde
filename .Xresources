! xterm*background: black

xterm*faceName: OCRA
xterm*faceSize: 18
xterm*renderFont: true

*customization: -color
XTerm*termName: xterm-256color

xterm*foreground: #CCCCCC
xterm*background: #0C0C0C

xterm*color0:  #0C0C0C
xterm*color1:  #C50F1F
xterm*color2:  #13A10E
xterm*color3:  #C19C00
xterm*color4:  #0037DA
! The real Campbell blue (color4:)is 0037DA, which is very dark on black.
! You can chage it to #3B78FF 
xterm*color5:  #881798
xterm*color6:  #3A96DD
xterm*color7:  #CCCCCC
xterm*color8:  #767676
xterm*color9:  #E74856
xterm*color10: #16C60C
xterm*color11: #F9F1A5
xterm*color12: #3B78FF
xterm*color13: #B4009E
xterm*color14: #61D6D6
xterm*color15: #F2F2F2

!Windows Terminal	xterm resource

!background			xterm*background
!foreground			xterm*foreground
!black				xterm*color0
!red				xterm*color1
!green				xterm*color2
!yellow				xterm*color3
!blue				xterm*color4
!purple				xterm*color5
!cyan				xterm*color6
!white				xterm*color7
!brightBlack		xterm*color8
!brightRed			xterm*color9
!brightGreen		xterm*color10
!brightYellow		xterm*color11
!brightBlue			xterm*color12
!brightPurple		xterm*color13
!brightCyan			xterm*color14
!brightWhite		xterm*color15


! start xterm fullscreen
xterm*fullscreen: true

